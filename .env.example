# Nemotron connection for src/run_nemotron.py. Copy to .env and edit (.env is git-ignored).
# Any OpenAI-compatible server works:
#   NVIDIA NIM / vLLM (default) : http://localhost:8000/v1
#   Ollama                      : http://localhost:11434/v1
#   NVIDIA hosted API           : https://integrate.api.nvidia.com/v1   (needs NEMOTRON_API_KEY)
NEMOTRON_BASE_URL=http://localhost:8000/v1

# Model id as the server names it. Leave empty to auto-detect from GET /models
# (prefers an id containing "nemotron").
NEMOTRON_MODEL=

# Only needed for hosted endpoints. Never commit a real key.
NEMOTRON_API_KEY=

NEMOTRON_TEMPERATURE=0.2
# Reasoning models spend tokens thinking before answering; raise this if replies are cut off.
NEMOTRON_MAX_TOKENS=2048
# Seconds per request; large local models can be slow.
NEMOTRON_TIMEOUT=300

# Thinking effort sent as `reasoning_effort`: default (model's own), none (no thinking, fastest), low, medium, high.
# Measured best for nemotron-3-nano:4b: none (stable, 3-4x faster). Re-check bigger models with src/eval_model.py.
NEMOTRON_REASONING=default
# Force replies into PortGuard's JSON shape via response_format/json_schema (on/off). Dropped automatically if unsupported.
NEMOTRON_STRUCTURED=on
# Optional fixed sampling seed for reproducible runs.
NEMOTRON_SEED=

# Optional: Slack incoming-webhook URL for src/alerts.py (high-risk decisions awaiting approval).
# Leave empty to print alerts to the console instead.
SLACK_WEBHOOK_URL=
