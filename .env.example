# Nemotron connection for src/run_nemotron.py. Copy to .env and edit (.env is git-ignored).
# Any OpenAI-compatible server works:
#   NVIDIA NIM / vLLM (default) : http://localhost:8000/v1
#   Ollama                      : http://localhost:11434/v1
#   NVIDIA hosted API           : https://integrate.api.nvidia.com/v1   (needs NEMOTRON_API_KEY)
NEMOTRON_BASE_URL=http://localhost:8000/v1

# Model id as the server names it. Leave empty to auto-detect from GET /models
# (prefers an id containing "nemotron").
NEMOTRON_MODEL=

# Only needed for hosted endpoints. Never commit a real key.
NEMOTRON_API_KEY=

NEMOTRON_TEMPERATURE=0.2
# Reasoning models spend tokens thinking before answering; raise this if replies are cut off.
NEMOTRON_MAX_TOKENS=2048
# Seconds per request; large local models can be slow.
NEMOTRON_TIMEOUT=300

# Thinking effort sent as `reasoning_effort`: default (model's own), none (no thinking, fastest), low, medium, high.
# Measured best for nemotron-3-nano:4b: none (stable, 3-4x faster). Re-check bigger models with src/eval_model.py.
NEMOTRON_REASONING=default
# Force replies into Majeure's JSON shape via response_format/json_schema (on/off). Dropped automatically if unsupported.
NEMOTRON_STRUCTURED=on
# Optional fixed sampling seed for reproducible runs.
NEMOTRON_SEED=

# Optional: Slack incoming-webhook URL for src/alerts.py (high-risk decisions awaiting approval).
# Leave empty to print alerts to the console instead.
SLACK_WEBHOOK_URL=

# --- Snowflake (planned migration; src/db.py + docs/SNOWFLAKE_SCHEMA.sql) ---
# Not wired into the pipeline yet — it still runs on data/majeure.db (SQLite). Set these once
# you have a Snowflake account and want to switch src/init_db.py etc. over to src/db.py.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=

# --- Fallback LLM for the deployed backend (backend/app/main.py) ---
# The deployed backend can't reach a local Ollama instance. Primary: NEMOTRON_BASE_URL above
# pointed at https://integrate.api.nvidia.com/v1 with NEMOTRON_API_KEY set. If that call fails,
# fall back to Gemini.
GEMINI_API_KEY=

# --- Database backend (src/store.py) ---
# 'sqlite' (default) uses data/majeure.db. 'postgres' uses DATABASE_URL and is what the deployed
# service should run: Render's free tier has no persistent disk, so on SQLite every redeploy resets
# the database to the committed snapshot and discards everything the cron pipeline ingested plus
# every human approve/override in between.
DB_BACKEND=sqlite
# Supabase: use the **Session pooler** connection string (Connect -> Session pooler).
#   * the direct db.<ref>.supabase.co host is IPv6-only and Render has no IPv6 egress
#   * the transaction pooler on :6543 cannot hold prepared statements, which psycopg uses
# Percent-encode any of @ / : # ? [ ] % in the password, or the URL will not parse: @ -> %40.
# This is NOT the publishable or secret API key -- those are for PostgREST, not SQL.
DATABASE_URL=

# --- Sending an approved notice (src/mailer.py) ---
# Resend rather than SMTP: Render's free tier commonly blocks outbound SMTP ports, and a wrong key
# fails immediately instead of hanging. Without RESEND_API_KEY the Send button is disabled and the
# API refuses the send, rather than recording a notice as sent that never went anywhere.
RESEND_API_KEY=
# Must be on a domain verified with Resend. The default shared sender needs no DNS setup but can
# only deliver to the address that owns the Resend account.
NOTICE_FROM=Majeure <onboarding@resend.dev>
# Pre-filled recipient in the Send box; the operator can type a different one per send.
NOTICE_RECIPIENT=
